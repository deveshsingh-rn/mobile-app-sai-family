{
  "cli": {
    "version": ">= 19.0.5",
    "appVersionSource": "remote"
  },
  "build": {
    "ios-saikifamily": {
      "extends": "production",
      "environment": "production",
      "env": {
        "APP_VARIANT": "saikifamily"
      }
    },
    "android-qa": {
      "extends": "production",
      "environment": "production",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "android-store": {
      "extends": "production",
      "environment": "production",
      "android": { "buildType": "app-bundle" }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "development-main": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "main-development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production"
      }
    }
  },
  "submit": {
    "ios-saikifamily": {
      "ios": {
        "ascAppId": "6827524322",
        "appleTeamId": "WD52FCQP6X"
      }
    },
    "android-internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6821991729",
        "appleTeamId": "WD52FCQP6X"
      }
    }
  }
}
